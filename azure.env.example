# Copy to azure.env (or azure.development.env / azure.production.env) on the
# operator machine, then:
#   ./scripts/azure/deploy.sh --env development --secrets
# Never commit this file. DATABASE_URL stays on the VM, not in GitHub.

NODE_ENV=production

# Azure Flexible Server — sslmode=require is mandatory
DATABASE_URL=postgresql://stockpred:CHANGE_ME@stockpred-pg.postgres.database.azure.com:5432/stockpred_dev?sslmode=require&schema=public

POSTGRES_USER=stockpred
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=stockpred_dev

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

CORS_ORIGIN=https://dev.example.com
PUBLIC_URL=https://dev.example.com
CADDY_SITE=https://dev.example.com
# Until DNS exists, use:
# CADDY_SITE=http://:80
# PUBLIC_URL=http://YOUR_DEV_VM_IP

AUTH_SERVICE_URL=http://auth-service:3001
MARKET_DATA_SERVICE_URL=http://market-data-service:3002
SIGNAL_ENGINE_URL=http://signal-engine:3003
PATTERN_ENGINE_URL=http://pattern-engine:3004
BACKTEST_SERVICE_URL=http://backtest-service:3005
AUTO_TRADER_URL=http://auto-trader:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3007
ML_ENGINE_URL=http://ml-engine:8000

MARKET_DATA_PROVIDER=yahoo
STOCK_UNIVERSE_MODE=full-universe
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

ML_MODELS_DIR=/service/ml-models
