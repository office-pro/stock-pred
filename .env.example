# ============================================================
# StockPred platform environment - copy to .env and adjust.
# NEVER commit a real .env file. NEVER hardcode secrets in code.
# ============================================================

NODE_ENV=development

# --- Database ---
# Docker Postgres. If Windows/macOS already has PostgreSQL on 5432, set
# POSTGRES_PORT=5433 and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stockpred:stockpred@localhost:5432/stockpred?schema=public
POSTGRES_USER=stockpred
POSTGRES_PASSWORD=stockpred
POSTGRES_DB=stockpred

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
# Host processes (npm start): docker maps EXTERNAL on localhost:29092
# Inside docker compose: kafka:9092 (compose overrides this)
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=stockpred

# --- JWT (generate strong random values for production!) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access token lifetime in seconds. 604800 = 7 days so paper trading does not
# drop every 15 minutes. Use 900 in production if you want short sessions.
JWT_ACCESS_TTL_SECONDS=604800
JWT_REFRESH_TTL_SECONDS=604800

# --- Service ports ---
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
MARKET_DATA_SERVICE_PORT=3002
SIGNAL_ENGINE_PORT=3003
PATTERN_ENGINE_PORT=3004
BACKTEST_SERVICE_PORT=3005
AUTO_TRADER_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
ML_ENGINE_PORT=8000

# --- Internal service URLs (compose overrides these with container DNS names) ---
AUTH_SERVICE_URL=http://localhost:3001
MARKET_DATA_SERVICE_URL=http://localhost:3002
SIGNAL_ENGINE_URL=http://localhost:3003
PATTERN_ENGINE_URL=http://localhost:3004
BACKTEST_SERVICE_URL=http://localhost:3005
AUTO_TRADER_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
ML_ENGINE_URL=http://localhost:8000

# --- Frontend ---
# Comma-separated allow-list: built frontend (nginx :8080) + Vite dev server (:5173)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# --- Market data ---
# simulated: deterministic synthetic NSE/BSE feed (quick-start only)
# yahoo: pulls historical candles from Yahoo Finance (.NS suffix)
MARKET_DATA_PROVIDER=simulated
TICK_INTERVAL_MS=1000
# full-universe: official NSE/BSE master (run npm run ingest:listings)
# quick-start: ~100 liquid NSE names
STOCK_UNIVERSE_MODE=full-universe

# --- Trading & risk (compliance: PAPER is the default mode) ---
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
RISK_PER_TRADE_PCT=1
DAILY_DRAWDOWN_PCT=3
WEEKLY_DRAWDOWN_PCT=8
AUTO_TRADE_MIN_SIGNAL_CONFIDENCE=85
AUTO_TRADE_MIN_PATTERN_CONFIDENCE=80
AUTO_TRADE_MIN_RISK_REWARD=2
PAPER_TRADING_CAPITAL=1000000

# --- ML engine ---
ML_MODELS_DIR=./ml-models
ML_PREDICTION_INTERVAL_SECONDS=300
