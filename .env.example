# ============================================================
# StockPred platform environment - copy to .env.local (or .env) and fill in.
# NEVER commit real secrets. NEVER hardcode secrets in code.
# See docs/hybrid-dev-cloud.md for free-tier hybrid (cloud DB/Redis + local Kafka).
# ============================================================

NODE_ENV=development
# Logical environment: development | staging | production | test
APP_ENV=development

# --- Database (DEFAULT = local Docker Postgres) ---
# Start with: docker compose up -d postgres
DATABASE_URL=postgresql://stockpred:stockpred@localhost:5432/stockpred?schema=public

# Optional: only needed when running local Docker Postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=stockpred
# POSTGRES_PASSWORD=stockpred
# POSTGRES_DB=stockpred

# MDS-only Prisma pool (docker-compose market-data-service DATABASE_URL query params).
# Used when MDS runs in Compose against a URL you control — not assumed for managed DBs.
# MDS_DB_CONNECTION_LIMIT=20
# MDS_DB_POOL_TIMEOUT=30
# MDS_DB_PRESSURE_SIMULATE_MS=0
# MDS_CANDLE_WRITE_CHUNK=1000
# test-cloud (Supabase Session pooler ≈15 clients): defaults are MDS=2, others=1.
# CLOUD_DB_CONNECTION_LIMIT=1
# MDS_DB_CONNECTION_LIMIT=2
# start:all-cloud forces STOCK_UNIVERSE_MODE=full-universe and runs listings + canonical
# universe ingest while apps are paused. ALLOW_CLOUD_QUICK_START=1 keeps quick-start.
# SKIP_LISTINGS_INGEST=1 / SKIP_UNIVERSE_INGEST=1 skip those steps.

# Cloud / Supabase DEV (optional): put that URL in gitignored `.env.test-cloud`
# and run `npm run prisma:migrate:test-cloud` — do not overwrite local defaults here.
# See docs/hybrid-dev-cloud.md

# --- Redis (REDIS_MODE selects URL; independent of DATABASE_URL) ---
# default     → REDIS_LOCAL_URL (host: localhost; compose: redis://redis:6379)
# test-cloud  → REDIS_CLOUD_URL (Upstash rediss://… in .env.test-cloud — never commit)
REDIS_MODE=default
REDIS_LOCAL_URL=redis://localhost:6379
REDIS_CLOUD_URL=
# See docs/hybrid-dev-cloud.md

# --- Kafka (local during development) ---
# Host processes: docker maps EXTERNAL on localhost:29092
# Inside full docker compose: kafka:9092 (compose overrides)
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=stockpred
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Future managed Kafka (production) — leave empty locally:
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# --- JWT (generate strong random values for production!) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access token lifetime in seconds. 604800 = 7 days so paper trading does not
# drop every 15 minutes. Use 900 in production if you want short sessions.
JWT_ACCESS_TTL_SECONDS=604800
JWT_REFRESH_TTL_SECONDS=604800

# Shared token stamped by api-gateway / trader-agent on execution fan-out.
# Auto-trader rejects /trade/execute without this service identity.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# --- Service ports ---
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
MARKET_DATA_SERVICE_PORT=3002
SIGNAL_ENGINE_PORT=3003
PATTERN_ENGINE_PORT=3004
BACKTEST_SERVICE_PORT=3005
AUTO_TRADER_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
TRADER_AGENT_PORT=3008
ML_ENGINE_PORT=8000

# --- Internal service URLs (compose overrides these with container DNS names) ---
AUTH_SERVICE_URL=http://localhost:3001
MARKET_DATA_SERVICE_URL=http://localhost:3002
SIGNAL_ENGINE_URL=http://localhost:3003
PATTERN_ENGINE_URL=http://localhost:3004
BACKTEST_SERVICE_URL=http://localhost:3005
AUTO_TRADER_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
TRADER_AGENT_URL=http://localhost:3008
ML_ENGINE_URL=http://localhost:8000

# Cursor SDK (Agent desk → Implement on capability suggestions)
# CURSOR_API_KEY=
# CURSOR_AGENT_MODEL=composer-2.5
# REPO_ROOT=

# --- Frontend ---
# Comma-separated allow-list: built frontend (nginx :8080) + Vite dev server (:5173)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# --- Market data ---
# simulated: deterministic synthetic NSE/BSE feed (quick-start only)
# yahoo: pulls historical candles from Yahoo Finance (.NS suffix)
MARKET_DATA_PROVIDER=simulated
TICK_INTERVAL_MS=1000
# Min gap / max wait for last-trade Yahoo fetch on a viewed symbol
LIVE_QUOTE_MIN_MS=5000
LIVE_QUOTE_WAIT_MS=1500
# full-universe: official NSE/BSE master (run npm run ingest:listings)
# quick-start: ~100 liquid NSE names
STOCK_UNIVERSE_MODE=quick-start

# --- Trading & risk (compliance: PAPER is the default mode) ---
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
RISK_PER_TRADE_PCT=1
DAILY_DRAWDOWN_PCT=3
WEEKLY_DRAWDOWN_PCT=8
AUTO_TRADE_MIN_SIGNAL_CONFIDENCE=85
AUTO_TRADE_MIN_PATTERN_CONFIDENCE=80
AUTO_TRADE_MIN_RISK_REWARD=2
PAPER_TRADING_CAPITAL=10000000

# --- Bull-run scanner ---
VOLUME_BREAKOUT_MULTIPLIER=1.5
BULL_SCORE_CANDIDATE=85
BULL_SCORE_STRONG=70
BULL_SCORE_BULLISH=55
BULL_SCORE_NEUTRAL=45
BULL_SCORE_WEAK=30
SCANNER_ALERT_MIN_BULL_SCORE=80
SCANNER_ALERT_MIN_UP_PROB=75
SCANNER_ALERT_MIN_EXPECTED_20D=8
SCANNER_ALERT_MIN_VOLUME_RATIO=1.5
SCANNER_ALERT_MIN_CONFIDENCE=55
SCANNER_ALERT_COOLDOWN_HOURS=4

# --- ML engine ---
ML_MODELS_DIR=./ml-models
ML_PREDICTION_INTERVAL_SECONDS=300
# MDS: delay first prediction/manipulation refresh after startup (ms).
# Keeps ML off the EOD hydrate + Yahoo bootstrap hot path. Default 45000.
MDS_ML_REFRESH_INITIAL_DELAY_MS=45000
# 0 = score every listed symbol on the periodic loop. Positive = cap.
ML_PREDICT_UNIVERSE_LIMIT=0
# 1 = skip train:ml:all + predict:ml:all at the end of npm run start:all
SKIP_ML_BOOTSTRAP=1
# 1 = skip NSE/US/crypto universe ingest at the end of npm run start:all
SKIP_UNIVERSE_INGEST=0
# Optional approved JSON futures feeds (never scrape MCX/CME webpages)
# MCX_APPROVED_FEED_URL=
# CME_APPROVED_FEED_URL=

# --- Twelve Data (quotes + OHLCV only; never TD indicator endpoints) ---
# Copy to .env as TWELVE_DATA_API_KEY=<your key>. Never commit the real key.
# TWELVE_DATA_API_KEY=
# Optional per-batch credit ceiling (Basic plan ~8 credits/minute)
# TWELVE_DATA_CREDIT_BUDGET=8
