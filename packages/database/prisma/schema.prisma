// StockPred platform schema.
// Spec tables: stocks, signals, predictions, patterns, trades, users, brokers, audit_logs.
// Supporting tables: refresh_tokens (token rotation), notifications, backtest_runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stock {
  id           String    @id @default(uuid())
  symbol       String    @unique
  name         String
  exchange     String
  sector       String
  indices      String[]
  isin         String?   @unique
  series       String?
  bseCode      String?   @map("bse_code")
  yahooSymbol  String?   @map("yahoo_symbol")
  listed       Boolean   @default(true)
  listingDate  DateTime? @map("listing_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  signals             Signal[]
  predictions         Prediction[]
  predictionOutcomes  PredictionOutcome[]
  patterns            Pattern[]
  trades              Trade[]
  patternOccurrences  PatternOccurrence[]

  @@index([listed, exchange])
  @@map("stocks")
}

model Signal {
  id         String   @id @default(uuid())
  symbol     String
  signal     String
  confidence Float
  price      Float
  target     Float
  stopLoss   Float    @map("stop_loss")
  riskReward Float    @map("risk_reward")
  rules      Json
  createdAt  DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [symbol], references: [symbol])

  @@index([symbol, createdAt])
  @@map("signals")
}

model Prediction {
  id           String   @id @default(uuid())
  symbol       String
  horizon      String
  direction    String
  confidence   Float
  expectedMove Float    @map("expected_move")
  modelVersion String   @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [symbol], references: [symbol])

  @@index([symbol, horizon, createdAt])
  @@map("predictions")
}

model PredictionOutcome {
  id            String    @id @default(uuid())
  symbol        String
  horizon       String
  predicted     String
  confidence    Float
  entry         Float
  target        Float?
  stopLoss      Float?    @map("stop_loss")
  quantity      Int       @default(0)
  actualReturn  Float?    @map("actual_return")
  correct       Boolean?
  predictedAt   BigInt    @map("predicted_at")
  scoredAt      DateTime? @map("scored_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  stock Stock @relation(fields: [symbol], references: [symbol])

  @@index([horizon, scoredAt])
  @@index([symbol, horizon, predictedAt])
  @@map("prediction_outcomes")
}

model Pattern {
  id         String   @id @default(uuid())
  symbol     String
  pattern    String
  direction  String
  confidence Float
  signal     String
  createdAt  DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [symbol], references: [symbol])

  @@index([symbol, createdAt])
  @@map("patterns")
}

model Trade {
  id            String    @id @default(uuid())
  symbol        String
  side          String
  quantity      Int
  price         Float
  mode          String
  status        String
  target        Float?
  stopLoss      Float?    @map("stop_loss")
  exitPrice     Float?    @map("exit_price")
  exitReason    String?   @map("exit_reason")
  pnl           Float?
  userId        String?   @map("user_id")
  brokerOrderId String?   @unique @map("broker_order_id")
  executedAt    DateTime  @default(now()) @map("executed_at")
  closedAt      DateTime? @map("closed_at")

  stock Stock @relation(fields: [symbol], references: [symbol])
  user  User? @relation(fields: [userId], references: [id])

  @@index([symbol, status])
  @@index([status, executedAt])
  @@map("trades")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("VIEWER")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  brokers       Broker[]
  trades        Trade[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Broker {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  name                 String
  authorized           Boolean  @default(false)
  // Credentials are stored encrypted (AES-256-GCM) - never plaintext.
  credentialsEncrypted String?  @map("credentials_encrypted")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("brokers")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   Json?
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  symbol    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notifications")
}

// Real-data candle cache: populated from live providers (Yahoo/broker),
// served back when the platform runs offline. Never stores simulated data.
model CandleRow {
  id        String @id @default(uuid())
  symbol    String
  timeframe String
  time      BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe])
  @@map("candles")
}

// Historical named-pattern hits + forward outcomes (analog suggestions).
model PatternOccurrence {
  id           String   @id @default(uuid())
  symbol       String
  pattern      String
  timeframe    String   @default("1d")
  direction    String
  confidence   Float
  price        Float
  confirmedAt  BigInt   @map("confirmed_at")
  return5      Float?   @map("return_5")
  return10     Float?   @map("return_10")
  return20     Float?   @map("return_20")
  maxFavorable Float?   @map("max_favorable")
  maxAdverse   Float?   @map("max_adverse")
  createdAt    DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [symbol], references: [symbol])

  @@unique([symbol, pattern, timeframe, confirmedAt])
  @@index([symbol, pattern])
  @@map("pattern_occurrences")
}

model BacktestRun {
  id                  String   @id @default(uuid())
  symbol              String
  years               Int
  initialCapital      Float    @map("initial_capital")
  riskPerTradePercent Float    @map("risk_per_trade_percent")
  metrics             Json
  trades              Json
  equityCurve         Json     @map("equity_curve")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("backtest_runs")
}

// Point-in-time fundamentals (Yahoo quoteSummary + quarterly statements).
// Join only rows with availableAt <= bar time — never today's PE on old bars.
model FundamentalSnapshot {
  id        String   @id @default(uuid())
  symbol    String
  asOfDate  DateTime @map("as_of_date")
  availableAt DateTime @map("available_at")
  source    String   @default("yahoo")
  sector    String?

  revenue       Float?
  pat           Float?
  eps           Float?
  ebit          Float?
  ebitda        Float?
  equity        Float?
  totalDebt     Float? @map("total_debt")
  totalAssets   Float? @map("total_assets")
  currentAssets Float? @map("current_assets")
  currentLiab   Float? @map("current_liab")
  cash          Float?
  ocf           Float?
  capex         Float?
  fcf           Float?

  revYoy        Float? @map("rev_yoy")
  patYoy        Float? @map("pat_yoy")
  epsYoy        Float? @map("eps_yoy")
  opMargin      Float? @map("op_margin")
  netMargin     Float? @map("net_margin")
  grossMargin   Float? @map("gross_margin")
  ebitdaMargin  Float? @map("ebitda_margin")
  roe           Float?
  roa           Float?
  roce          Float?
  debtEquity    Float? @map("debt_equity")
  currentRatio  Float? @map("current_ratio")
  cashRatio     Float? @map("cash_ratio")
  ocfPat        Float? @map("ocf_pat")
  fcfGrowth     Float? @map("fcf_growth")
  fcfMargin     Float? @map("fcf_margin")

  trailingEps     Float? @map("trailing_eps")
  bookValue       Float? @map("book_value")
  trailingPe      Float? @map("trailing_pe")
  priceToBook     Float? @map("price_to_book")
  sectorMedianPe  Float? @map("sector_median_pe")
  promoterHolding Float? @map("promoter_holding")
  institutionHolding Float? @map("institution_holding")
  displayScore    Float? @map("display_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([symbol, asOfDate])
  @@index([symbol, availableAt])
  @@index([availableAt])
  @@map("fundamental_snapshots")
}

// Maps headlines / social text onto NSE symbols. Unmatched entities are dropped.
model SymbolAlias {
  id        String   @id @default(uuid())
  alias     String
  symbol    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([alias, symbol])
  @@index([symbol])
  @@map("symbol_aliases")
}

model NewsArticle {
  id          String   @id @default(uuid())
  source      String
  url         String   @unique
  title       String
  publishedAt DateTime @map("published_at")
  availableAt DateTime @map("available_at")
  createdAt   DateTime @default(now()) @map("created_at")

  mentions NewsMention[]

  @@index([publishedAt])
  @@map("news_articles")
}

model NewsMention {
  id            String   @id @default(uuid())
  articleId     String   @map("article_id")
  symbol        String
  sentiment     Float
  pos           Float    @default(0)
  neg           Float    @default(0)
  neu           Float    @default(0)
  eventType     String   @map("event_type")
  eventStrength Float    @map("event_strength")
  confidence    Float    @default(0.5)
  createdAt     DateTime @default(now()) @map("created_at")

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, symbol])
  @@index([symbol])
  @@map("news_mentions")
}

// Pre-aggregated windows so train does not scan raw articles per bar.
model NewsDailyFeature {
  id                   String   @id @default(uuid())
  symbol               String
  asOfDate             DateTime @map("as_of_date")
  availableAt          DateTime @map("available_at")
  source               String   @default("news")
  newsCount1d          Float    @map("news_count_1d")
  newsCount7d          Float    @map("news_count_7d")
  newsCount30d         Float    @map("news_count_30d")
  newsSent1d           Float    @map("news_sent_1d")
  newsSent7d           Float    @map("news_sent_7d")
  newsSent30d          Float    @map("news_sent_30d")
  newsSentStd7d        Float    @map("news_sent_std_7d")
  newsSentChange7d     Float    @map("news_sent_change_7d")
  newsSentTrend30d     Float    @map("news_sent_trend_30d")
  newsPos7d            Float    @map("news_pos_7d")
  newsNeg7d            Float    @map("news_neg_7d")
  newsHighImpact7d     Float    @map("news_high_impact_7d")
  newsEventMomentum7d  Float    @map("news_event_momentum_7d")
  earningsSentiment    Float    @map("earnings_sentiment")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([symbol, asOfDate])
  @@index([symbol, availableAt])
  @@map("news_daily_features")
}

model SocialDailyFeature {
  id                    String   @id @default(uuid())
  symbol                String
  asOfDate              DateTime @map("as_of_date")
  availableAt           DateTime @map("available_at")
  source                String   @default("social")
  mentions1d            Float    @map("social_mentions_1d")
  mentions7d            Float    @map("social_mentions_7d")
  mentionGrowth         Float    @map("social_mention_growth")
  attentionSpike        Float    @map("social_attention_spike")
  uniqueAuthors1d       Float    @map("social_unique_authors_1d")
  sentiment1d           Float    @map("social_sent_1d")
  sentimentChange       Float    @map("social_sent_change")
  bullRatio7d           Float    @map("social_bull_ratio_7d")
  bearRatio7d           Float    @map("social_bear_ratio_7d")
  coordination          Float    @map("social_coordination")
  trendsScore7d         Float    @map("trends_score_7d")
  trendsChange7d        Float    @map("trends_change_7d")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([symbol, asOfDate])
  @@index([symbol, availableAt])
  @@map("social_daily_features")
}

model MacroObservation {
  id          String   @id @default(uuid())
  seriesId    String   @map("series_id")
  asOfDate    DateTime @map("as_of_date")
  availableAt DateTime @map("available_at")
  value       Float
  source      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([seriesId, asOfDate])
  @@index([seriesId, availableAt])
  @@map("macro_observations")
}

model MacroDailyFeature {
  id             String   @id @default(uuid())
  asOfDate       DateTime @map("as_of_date")
  availableAt    DateTime @map("available_at")
  source         String   @default("macro")
  usdinr         Float?
  usdinrChg20d   Float?   @map("usdinr_chg_20d")
  usdinrChg60d   Float?   @map("usdinr_chg_60d")
  brent          Float?
  brentChg20d    Float?   @map("brent_chg_20d")
  goldChg20d     Float?   @map("gold_chg_20d")
  us10y          Float?   @map("us10y")
  us10yChg20d    Float?   @map("us10y_chg_20d")
  spxChg20d      Float?   @map("spx_chg_20d")
  nasdaqChg20d   Float?   @map("nasdaq_chg_20d")
  dxyChg20d      Float?   @map("dxy_chg_20d")
  indiaCpi       Float?   @map("india_cpi")
  indiaCpiChg    Float?   @map("india_cpi_chg")
  repoRate       Float?   @map("repo_rate")
  repoChg90d     Float?   @map("repo_chg_90d")
  fiiFlow20d     Float?   @map("fii_flow_20d")
  diiFlow20d     Float?   @map("dii_flow_20d")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([asOfDate])
  @@index([availableAt])
  @@map("macro_daily_features")
}
